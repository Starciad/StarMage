<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- METADATA -->
	<PropertyGroup>
		<Title>Star Mage</Title>
		<Authors>Davi "Starciad" Fernandes</Authors>
		<Company>Davi "Starciad" Fernandes</Company>
		<Product>Star Mage</Product>
		<Description>A small 2D side-scrolling shoot 'em up game with procedurally generated levels.</Description>
		<Copyright>Copyright © Davi "Starciad" Fernandes. All rights Reserved.</Copyright>
		<NeutralLanguage>en-US</NeutralLanguage>
	</PropertyGroup>

    <!-- VERSIONING -->
	<PropertyGroup>
		<Version>1.1.0.0</Version>
		<AssemblyVersion>1.1.0.0</AssemblyVersion>
		<FileVersion>1.1.0.0</FileVersion>
		<PackageVersion>1.1.0.0</PackageVersion>
	</PropertyGroup>
</Project>